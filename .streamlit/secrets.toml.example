# Copy to .streamlit/secrets.toml for local runs. On Streamlit Cloud paste the same into the app's Secrets.
# IMPORTANT: keep the [users] table at the BOTTOM. Every line after a [table] header belongs to that table.
GEMINI_API_KEY = "your gemini key"
GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "Kazuto16K/lead-data"

[users]
manager = "choose-a-password"
admin = "choose-another-password"
